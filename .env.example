# ==============================================================================
# Two Valley — Environment Variables Template (.env.example)
# ==============================================================================
# STATUS: Authoritative Specification
# ALIGNED WITH: ARCHITECTURE.md, RULES.md, SECURITY.md, DECISIONS.md
#
# INSTRUCTIONS:
# Copy this file to `.env.local` for local development.
# NEVER commit actual secrets, keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-FACING VARIABLES (Exposed to browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------

# Base URL of the Two Valley application (used for absolute URL generation and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Project URL (Public REST/Auth endpoint for customer client authentication)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon/Public Key (Client-side API key for Supabase Auth and public queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"


# ------------------------------------------------------------------------------
# 2. PRIVATE / SERVER-ONLY SECRETS (NEVER exposed to browser / No NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Admin/Server-only key with full DB privileges; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# Primary PostgreSQL Connection String (Transaction pooled connection for Prisma Client)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct PostgreSQL Connection String (Direct unpooled connection for Prisma migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY STORAGE SECRETS (Server-only; required for product image uploads)
# ------------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

